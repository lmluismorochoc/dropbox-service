# Variables de entorno — Dropbox Service

# Configuración de Dropbox (OAuth 2.0 con Refresh Tokens)
# Obtén tu Client ID y Secret en: https://www.dropbox.com/developers/apps
DROPBOX_CLIENT_ID=ymrimv3xu823vc7
DROPBOX_CLIENT_SECRET=ne6u111wgngtg11

# El Refresh Token se obtiene mediante el flujo de autorización de Dropbox
# Este token no expira y permite al servicio generar nuevos Access Tokens automáticamente
DROPBOX_REFRESH_TOKEN=tu_refresh_token

# (Opcional) Token de acceso de corta duración (el SDK lo renovará usando el Refresh Token)
DROPBOX_ACCESS_TOKEN=tu_access_token

# Puerto en que escucha el servicio (default: 3000)
PORT=3000

